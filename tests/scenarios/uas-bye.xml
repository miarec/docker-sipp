<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- The callee of the TCP reconnection test in tests/smoke-test.sh after its
     restart. It no longer knows the call, so it takes the BYE as a new one,
     and answers it. -->
<scenario name="Smoke test UAS, BYE after a restart">

  <recv request="BYE"/>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

</scenario>
